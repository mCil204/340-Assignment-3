<#import "layout.ftlh" as l>
<@l.page title="About" active="about" mainClass="about-page">
    <div class="about-text">
        <h1>About This Project</h1>
        <p>
            This website is a character gallery for the game Limbus Company. It is a fun single-player
            turn-based RPG with interesting characters and a great story. My sister really likes this game,
            so I decided to use it as my theme for this project.
        </p>
    </div>

    <div class="about-image">
        <img src="/images/thecrew.jpg" alt="Main Cast of Limbus Company artwork">
    </div>
</@l.page>